# ============================================
# YASEMIN'S CREATIONS - ENVIRONMENT VARIABLES
# ============================================

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
# Turso Database Connection
# Get credentials from: https://turso.tech/
TURSO_CONNECTION_URL=your_turso_connection_url
TURSO_AUTH_TOKEN=your_turso_auth_token

# ============================================
# ADMIN AUTHENTICATION (Required)
# ============================================
# Generate a strong random string (minimum 32 characters)
# Use: openssl rand -base64 32
ADMIN_JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars

# ============================================
# PAYMENT INTEGRATION - PAYPAL ONLY (Required)
# ============================================
# This is the ONLY payment method supported!
# Get credentials from: https://developer.paypal.com/dashboard/

# Step 1: Sign in to PayPal Developer Dashboard
# Step 2: Go to "My Apps & Credentials"
# Step 3: Toggle to LIVE mode (top right) for production
# Step 4: Create app or select existing app
# Step 5: Copy Client ID and Secret

# PayPal Client ID (Public - exposed to frontend)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# PayPal Client Secret (Private - server-side only)
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# PayPal Mode: 'sandbox' for testing, 'live' for production
# CRITICAL: Set to 'live' when ready to accept real payments!
PAYPAL_MODE=live

# ============================================
# IMAGE HOSTING - CLOUDINARY (Required)
# ============================================
# Get credentials from: https://cloudinary.com/
# Free tier is sufficient for small to medium galleries

# Cloudinary Cloud Name (Public)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary Upload Preset (Public - must be unsigned)
# Create this in Cloudinary Dashboard > Settings > Upload > Upload Presets
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ============================================
# WEBSITE CONFIGURATION (Optional)
# ============================================
# Your production website URL
NEXT_PUBLIC_SITE_URL=https://yaseminscreations.com
NEXT_PUBLIC_APP_URL=https://yaseminscreations.com

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================

# Google Analytics (Future feature)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Email Notifications (Future feature - for order confirmations)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Social Media Links (Update with your actual handles)
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/yaseminscreations
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yaseminscreations
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/yaseminscreate

# Admin Contact Email
# ADMIN_EMAIL=admin@yaseminscreations.com

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before going live, ensure:
# ✅ PAYPAL_MODE is set to 'live'
# ✅ PayPal credentials are from LIVE dashboard (not sandbox)
# ✅ ADMIN_JWT_SECRET is a strong random string
# ✅ Database is backed up regularly
# ✅ Cloudinary has sufficient storage
# ✅ NEXT_PUBLIC_SITE_URL points to your domain
# ✅ All credentials are kept secure (never commit .env to Git)

# ============================================
# SECURITY NOTES
# ============================================
# - Never commit .env file to version control
# - Keep PAYPAL_CLIENT_SECRET and ADMIN_JWT_SECRET secure
# - Rotate secrets periodically
# - Use HTTPS in production
# - Enable 2FA on PayPal account
# - Regular database backups recommended